-tester: biz.aQute.tester.junit-platform
-runfw: org.apache.felix.framework
-resolve.effective: resolve,active
-runee: JavaSE-17
-runtrace: true

-runvm: \
    -Dco.paralleluniverse.fibers.verifyInstrumentation,\
    -Djava.security.policy=all.policy,\
    -Djava.util.logging.config.file=${.}/logging.properties,\
    '--add-opens', 'java.base/java.lang.invoke=ALL-UNNAMED',\
    '--add-opens', 'java.base/java.util=ALL-UNNAMED'

-runproperties: \
    co.paralleluniverse.quasar.suspendableAnnotation='org.testing.osgi.annotation.Suspendable',\
    co.paralleluniverse.quasar.cacheDirectory='${task.cacheDirectory}',\
    co.paralleluniverse.quasar.cacheLocations='CACHED/*',\
    co.paralleluniverse.quasar.excludeLocations='IGNORE/*,VERIFY/*',\
    co.paralleluniverse.quasar.excludePackages='aQute.**,org.osgi.**,org.apache.felix.**,org.junit.**,org.assertj.**,org.opentest4j**',\
    co.paralleluniverse.quasar.service,\
    co.paralleluniverse.quasar.verbose,\
    org.osgi.framework.bundle.parent=framework,\
    org.osgi.framework.security=osgi

-runrequires: \
    bnd.identity;id='quasar-osgi-tests',\
    bnd.identity;id='co.paralleluniverse.quasar-core',\
    bnd.identity;id='org.apache.felix.configadmin',\
    bnd.identity;id='org.apache.felix.framework.security',\
    bnd.identity;id='org.apache.felix.log',\
    bnd.identity;id='junit-jupiter-engine',\
    bnd.identity;id='junit-platform-launcher',\
    bnd.identity;id='slf4j.simple'

-runstartlevel: \
    order=sortbynameversion,\
    begin=-1
